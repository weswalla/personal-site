---
import Base from '../layouts/Base.astro';

// Edit this list to feature your work.
const projects = [
  {
    title: 'Example Project',
    description: 'A short description of what it is and your role.',
    href: '#',
  },
];
---

<Base title="Portfolio — Wesley Finck" description="Selected work by Wesley Finck.">
  <h1>Portfolio</h1>
  <p class="lead">A few things I've built.</p>

  <ul class="card-list">
    {
      projects.map((project) => (
        <li>
          <h3>
            {project.href && project.href !== '#' ? (
              <a href={project.href}>{project.title}</a>
            ) : (
              project.title
            )}
          </h3>
          <p>{project.description}</p>
        </li>
      ))
    }
  </ul>
</Base>
